{
  "name": "pdf-export",
  "version": "0.0.0",
  "private": true,
  "description": "Reactome's pathway PDFs from the graph: the release's book and the website's single-event PDF (spec 001).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pdf-export": "src/cli.ts"
  },
  "scripts": {
    "build": "node src/layout/theme.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "node --test --test-concurrency=4 --test-timeout=300000 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format && npm test && node ci/licences.ts"
  },
  "devDependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/material": "22.2.7",
    "@eslint/js": "10.0.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.15.0",
    "ngx-reactome-style": "github:reactome/ngx-reactome-base#74c0891a8d27ed79ec1a9ca0aa573cb99242a208",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "fontkit": "3.0.0",
    "neo4j-driver": "6.3.2",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.1",
    "sanitize-html": "2.18.2"
  }
}
