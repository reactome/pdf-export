{
  "name": "pdf-export",
  "version": "0.0.0",
  "private": true,
  "description": "Reactome's pathway PDFs from the graph: the release's book and the website's single-event PDF (spec 001).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pdf-export": "src/cli.ts"
  },
  "scripts": {
    "build": "node src/layout/theme.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "node --test --test-concurrency=4 --test-timeout=300000 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format && npm test && node ci/licences.ts"
  },
  "devDependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/material": "22.2.5",
    "@eslint/js": "10.0.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.14.0",
    "ngx-reactome-style": "github:reactome/ngx-reactome-base#606de81b66283029fb0ccfa170ed757e95701a35",
    "prettier": "3.9.10",
    "sass": "1.107.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "fontkit": "2.0.4",
    "neo4j-driver": "6.3.0",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.64.1",
    "sanitize-html": "2.18.1"
  }
}
