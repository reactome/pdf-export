// The fixture graph (spec 001 T003): a small release, written for these tests. Every
// person is a placeholder and every text is made up (constitution VII). Ids are from
// 90000000, beyond Reactome's, so none is mistaken for a real event. ci/fixture/README.md
// lists the case each item is here for. Load with: cypher-shell -d graph.db -f fixture.cypher
CREATE INDEX fixture_dbId IF NOT EXISTS FOR (n:DatabaseObject) ON (n.dbId);
CREATE INDEX fixture_stId IF NOT EXISTS FOR (n:DatabaseObject) ON (n.stId);
